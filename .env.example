# Kopieren nach .env und ausfüllen. .env wird NICHT ins Git eingecheckt.

# Passwort für den Verwaltungsbereich (Benutzername beliebig). Unbedingt setzen, wenn die App im Internet läuft!
ADMIN_PASSWORT=

# E-Mail-Versand (z. B. IONOS: smtp.ionos.de / 587, Strato: smtp.strato.de / 465, Gmail: smtp.gmail.com / 587 mit App-Passwort)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Hausmeister Helden <info@hausmeister-helden.de>

# Bei neuer Website-Anfrage sofort Benachrichtigung an diese Adresse
BENACHRICHTIGUNG_EMAIL=

# Server
HOST=127.0.0.1
PORT=5000
SECRET_KEY=bitte-zufaelligen-wert-eintragen
