# ======================================================================
# DealFehler – Umgebungsvariablen. Kopieren nach .env und Werte setzen.
# .env NIEMALS committen (steht in .gitignore).
# ======================================================================

# --- Allgemein ---
APP_ENV=production
PUBLIC_BASE_URL=https://www.deine-domain.de        # Website (Next.js)
API_BASE_URL=https://api.deine-domain.de           # Backend (Medien-URLs)
NEXT_PUBLIC_API_URL=https://api.deine-domain.de    # vom Browser erreichbare API
CORS_ORIGINS=https://www.deine-domain.de
TIMEZONE=Europe/Berlin
LOG_JSON=true

# --- Sicherheit (Pflicht!) ---
# Erzeugen: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Datenbank ---
POSTGRES_USER=dealfehler
POSTGRES_PASSWORD=
POSTGRES_DB=dealfehler
BACKUP_KEEP_DAYS=14
BACKUP_HOST_DIR=./backups

# --- Betrieb ---
# true = nichts wird extern auf Social Media veröffentlicht (nur simuliert). Erst nach Live-Test umstellen.
DRY_RUN=true
MAX_PRICE_AGE_MINUTES=60

# --- Amazon PartnerNet ---
AMAZON_PARTNER_TAG=                    # z.B. dealfehler-21
AMAZON_MARKETPLACE=www.amazon.de
# Optional: eigene Tracking-IDs je Kanal (in PartnerNet anlegen)
AMAZON_CHANNEL_TRACKING_IDS=           # instagram=dealfehler-ig-21,pinterest=dealfehler-pin-21,telegram=dealfehler-tg-21

# --- Datenquellen ---
KEEPA_API_KEY=
KEEPA_DOMAIN=3
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

# --- KI (optional; ohne Key: Vorlagentexte) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_DAILY_BUDGET_USD=2
LLM_MONTHLY_BUDGET_USD=40

# --- Medien (Instagram braucht öffentlich erreichbare https-URLs) ---
STORAGE_BACKEND=local                  # local | s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Instagram (Meta Graph API) ---
META_GRAPH_VERSION=v23.0
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- Pinterest API v5 ---
PINTEREST_ACCESS_TOKEN=

# --- Telegram (Kanal + Alarme) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=                   # z.B. @dealfehler
ALERT_TELEGRAM_CHAT_ID=                # privater Chat für Alarme

# --- WhatsApp-Kanal (manuelle Veröffentlichung) ---
WHATSAPP_CHANNEL_INVITE_URL=

# --- Alarme (optional, z.B. Slack/Discord-Webhook) ---
ALERT_WEBHOOK_URL=
