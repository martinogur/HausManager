[Unit]
Description=Hausmeister Helden Portal – wöchentlicher Wiederherstellungstest
Requires=hh-secrets.service docker.service
After=hh-secrets.service docker.service network-online.target hh-backup.service
Wants=network-online.target
OnFailure=hh-alarm@%n.service

[Service]
Type=oneshot
Nice=10
ExecStart=/usr/bin/bash /opt/hh-portal/portal/deploy/backup/restore-test.sh
TimeoutStartSec=2h
