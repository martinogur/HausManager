# Entschlüsselt beim Systemstart die Secrets nach /run/hh-portal (Arbeitsspeicher).
# Installation: siehe portal/docs/04-betrieb.md, Abschnitt "systemd".
[Unit]
Description=Hausmeister Helden Portal – Secrets entschlüsseln (SOPS + age)
After=local-fs.target
Before=hh-portal.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=SOPS_AGE_KEY_FILE=/etc/hh-portal/age.key
ExecStart=/usr/bin/bash /opt/hh-portal/portal/deploy/secrets-entschluesseln.sh

[Install]
WantedBy=multi-user.target
