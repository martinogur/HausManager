# Vorlage für portal/deploy/.env – NUR PLATZHALTER, keine echten Werte eintragen und nie committen.
#
# Server: Die echten Werte stehen verschlüsselt in secrets.enc.yaml (SOPS + age) und werden von
#         secrets-entschluesseln.sh nach /run/hh-portal/portal.env (Arbeitsspeicher) geschrieben;
#         portal/deploy/.env ist dann nur ein Symlink darauf.
# Lokal:  cp .env.example .env und Testwerte eintragen.
#
# Regeln für Werte: nur Buchstaben, Ziffern und - _ . : / @ , (keine Leerzeichen, kein $, keine Anführungszeichen).
# Zufallswerte erzeugen:  openssl rand -hex 32

# --- Django (Absprachen Punkt 9) -------------------------------------------
DJANGO_SECRET_KEY=PLATZHALTER-openssl-rand-hex-50
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=portal.haus-meister-helden.de
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.haus-meister-helden.de
# Passwort muss identisch mit POSTGRES_PASSWORD sein; Host "db" = Datenbank-Container
DATABASE_URL=postgresql://hh:PLATZHALTER-postgres-passwort@db:5432/hh

# --- Datenbank-Container ----------------------------------------------------
POSTGRES_PASSWORD=PLATZHALTER-postgres-passwort

# --- Caddy ------------------------------------------------------------------
PORTAL_DOMAIN=portal.haus-meister-helden.de
# Adresse für Hinweise von Let's Encrypt (Ablauf von Zertifikaten)
ACME_EMAIL=PLATZHALTER@example.org

# --- Optional ---------------------------------------------------------------
# Image-Tag, z. B. Git-Commit (Standard: lokal)
PORTAL_VERSION=lokal
GUNICORN_WORKERS=3

# --- Backup (nur auf dem Server, liest backup/backup.sh) --------------------
# Beispiel Hetzner Storage Box über SFTP (erst nach Freigabe buchen):
#   RESTIC_REPOSITORY=sftp:uXXXXXX@uXXXXXX.your-storagebox.de:/./hh-portal
RESTIC_REPOSITORY=PLATZHALTER-restic-repository
RESTIC_PASSWORD=PLATZHALTER-restic-passwort
# Optional: URL, die nach erfolgreichem Backup aufgerufen wird (z. B. Healthchecks-Ping). Leer = aus.
HH_MELDE_URL=
